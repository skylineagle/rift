{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rift",
  "identifier": "dev.rift.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rift",
        "width": 1240,
        "height": 780,
        "minWidth": 980,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBBMkIwODc3OEI1MTZFMDQKUldRRWJsR0xkd2dyQ3JUQ3NvemloV1hCTlhvbzFCblJGTHlFRWwwSDZxd1VMY2QxL2YzUyt0VHMK",
      "endpoints": [
        "https://github.com/skylineagle/rift/releases/latest/download/latest.json"
      ]
    }
  }
}
